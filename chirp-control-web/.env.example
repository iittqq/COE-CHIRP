# Copy to .env.local (gitignored) and fill in your deployment's endpoints.
# HTTP API Gateway base URL for /auth, /sonars and /scans (no trailing slash).
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com
# WebSocket API Gateway URL including stage, used for scan control.
VITE_WS_URL=wss://<api-id>.execute-api.<region>.amazonaws.com/<stage>
